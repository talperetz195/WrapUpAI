# העתיקי את הקובץ הזה ל-.env ומלאי אחת מהאפשרויות. בלי מפתח - המערכת רצה במצב דמו.

# אפשרות 1: Claude דרך Azure (Microsoft Foundry)
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# ב-Azure: שם ה-deployment של המודל
CLAUDE_MODEL=claude-opus-5-5

# אפשרות 2: Claude ישירות מ-Anthropic
# ANTHROPIC_API_KEY=

# ---------- תמלול שמע: Azure Speech (משאב Speech נפרד ב-Azure) ----------
AZURE_SPEECH_KEY=
# למשל: https://my-speech.cognitiveservices.azure.com
AZURE_SPEECH_ENDPOINT=

# ---------- תיקיית ההקלטות שהמרכזייה שומרת אליה (ברירת מחדל: recordings בפרויקט) ----------
# RECORDINGS_DIR=/path/to/pbx/recordings

# ---------- שליחת הדוחות במייל (לא חובה; בלי זה הדוחות נשמרים ב-outbox ובממשק) ----------
BUSINESS_NAME=בנק השרון
# BUSINESS_EMAIL=office@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---------- ניתוח עם GPT דרך Azure OpenAI (במנוי סטודנטים - זה מה שזמין) ----------
AZURE_OPENAI_API_KEY=
# למשל: https://wrapupai-openai-jct.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---------- מערכות עסק מחוברות (אפשר כמה: CONNECTOR_2_* ...) ----------
CONNECTOR_1_NAME=בנק השרון - מערכת מוקד
CONNECTOR_1_URL=http://localhost:9000
CONNECTOR_1_KEY=demo-key-123

# ---------- מייל ללקוחות: Gmail API (מחברים פעם אחת: .venv/bin/python app/gmail.py) ----------
# לדמו: כל המיילים ללקוחות מופנים לכתובת אחת (כדי לא לשלוח לכתובות של לקוחות הדמה)
# EMAIL_TEST_RECIPIENT=your.address@gmail.com

# ---------- גשר למרכזיית הצוות ----------
TEAM_BRIDGE_SECRET=
TEAM_INGEST_URL=http://127.0.0.1:3000/api/internal/ingest-report
